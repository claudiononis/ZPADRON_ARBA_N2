managed implementation in class znbp_i_pa_jobs unique;
strict ( 2 );

define behavior for ZNI_PA_JOBS alias Job
persistent table znfi_pa_job
with additional save
lock master
authorization master ( global )
{
  create;
  update;
  delete;

  action StartProcessing result [1] $self;

  association _JobLogEntries { create; }

  field ( numbering : managed, readonly ) Id;

  mapping for znfi_pa_job
  {
    Id           = id;
    JobId        = job_id;
    Status       = status;
    Message      = message;
    FileName     = file_name;
    TotalRows    = total_rows;
    FoundRows    = found_rows;
    NotFoundRows = not_found_rows;
    CreateCount  = create_count;
    UpdateCount  = update_count;
    ErrorCount   = error_count;
    AppliedCount = applied_count;
    ErrorText    = error_text;
    CreatedAt    = created_at;
    StartedAt    = started_at;
    FinishedAt   = finished_at;
  }
}

define behavior for ZNI_PA_JOBLOGENTRIES alias JobLogEntry
persistent table znfi_pa_joblog
lock dependent by _Job
authorization dependent by _Job
{
  update;
  delete;

  field ( numbering : managed, readonly ) Id;
  field ( readonly ) JobUuid;

  association _Job;

  mapping for znfi_pa_joblog
  {
    Id                    = id;
    JobUuid               = job_uuid;
    LineNumber            = line_number;
    Cuit                  = cuit;
    BusinessPartner       = business_partner;
    CustomerId            = customer_id;
    Nombre                = nombre;
    FechaDesde            = fecha_desde;
    FechaHasta            = fecha_hasta;
    Alicuota              = alicuota;
    AltaBaja              = alta_baja;
    CambioAlicuota        = cambio_alicuota;
    CategoriaFiscal       = categoria_fiscal;
    CategoriaFiscalEstado = categoria_fiscal_estado;
    ConditionRecord       = condition_record;
    PublicationDate       = publication_date;
    TipoContribuyente     = tipo_contribuyente;
    Grupo                 = grupo;
    Estado                = estado;
    EstadoColor           = estado_color;
    EstadoIcono           = estado_icono;
    Accion                = accion;
    Detalle               = detalle;
  }
}