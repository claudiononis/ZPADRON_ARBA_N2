
projection;
strict ( 2 );

define behavior for ZNC_PA_JOBS alias Job
{
  use create;
  use update;
  use delete;

  use action StartProcessing;

  use association _JobLogEntries { create; }
}

define behavior for ZNC_PA_JOBLOGENTRIES alias JobLogEntry
{
  use update;
  use delete;

  use association _Job;
}